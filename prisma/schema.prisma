
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum RequestStatus {
  NEW
  UNDER_REVIEW
  QUOTED
  AWAITING_PAYMENT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  STAFF
}

enum RequestActivityType {
  STATUS_CHANGE
  INTERNAL_NOTE
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PaymentMethod {
  MPESA
  BANK_TRANSFER
  CASH
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

// ==========================================
// ADMINISTRATOR ACCOUNTS
// ==========================================

model AdminUser {
  id           String    @id @default(uuid())
  fullName     String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(STAFF)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  activities        RequestActivity[]
  quotationsCreated ServiceQuotation[]
  paymentsRecorded  Payment[]

  @@index([role])
  @@index([isActive])
}

// ==========================================
// CUSTOMERS
// ==========================================

model Customer {
  id        String   @id @default(uuid())
  fullName  String
  phone     String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests ServiceRequest[]

  @@index([phone])
  @@index([email])
}

// ==========================================
// CUSTOMER SERVICE REQUESTS
// ==========================================

model ServiceRequest {
  id          String        @id @default(uuid())
  reference   String        @unique
  department  String
  service     String
  description String
  status      RequestStatus @default(NEW)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  activities RequestActivity[]
  quotations ServiceQuotation[]
  payments   Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

// ==========================================
// SERVICE REQUEST ACTIVITY HISTORY
// ==========================================

model RequestActivity {
  id         String              @id @default(uuid())
  requestId  String
  adminId    String
  type       RequestActivityType
  fromStatus RequestStatus?
  toStatus   RequestStatus?
  note       String?
  createdAt  DateTime            @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  admin   AdminUser      @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([adminId])
}

// ==========================================
// SERVICE QUOTATIONS
// ==========================================

model ServiceQuotation {
  id              String @id @default(uuid())
  quotationNumber String @unique

  requestId String
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  amount   Decimal         @db.Decimal(12, 2)
  currency String          @default("KES")
  status   QuotationStatus @default(DRAFT)

  // QUOTATION SENDING RECORD
  sentAt     DateTime?
  sentById   String?
  sentByName String?

  description String?
  notes       String?
  validUntil  DateTime?

  createdById String
  createdBy   AdminUser @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId, createdAt])
  @@index([status])
  @@index([createdById])
  @@index([sentAt])
  @@index([sentById])
}

// ==========================================
// CUSTOMER PAYMENTS
// ==========================================

model Payment {
  id            String @id @default(uuid())
  receiptNumber String @unique

  requestId String
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("KES")

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  transactionReference String? @unique
  notes                String?
  paidAt               DateTime?

  recordedById String
  recordedBy   AdminUser @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId, createdAt])
  @@index([status])
  @@index([method])
  @@index([recordedById])
}
